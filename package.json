{
  "name": "claude-cockpit",
  "version": "1.0.0",
  "description": "Multi-project command center for Claude Code: tabs, live hook-driven statuses, workspace restore, prompt queue, history search, usage dashboards",
  "author": "lunev51",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lunev51/claude-cockpit.git"
  },
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test --test-timeout=30000",
    "postinstall": "cd node_modules/@homebridge/node-pty-prebuilt-multiarch && npx prebuild-install --runtime electron --target 29.4.6",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.lunev.claude-cockpit",
    "productName": "Cockpit",
    "asar": false,
    "compression": "store",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "config.json",
      "scripts/**",
      "node_modules/**"
    ],
    "win": {
      "target": "portable"
    },
    "electronVersion": "29.4.6"
  }
}
