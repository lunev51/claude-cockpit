{
  "name": "claude-companion",
  "version": "0.1.0",
  "description": "Локальный терминал-компаньон для Claude Code: голос + 3D VRM-аватар",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "postinstall": "cd node_modules/@homebridge/node-pty-prebuilt-multiarch && npx prebuild-install --runtime electron --target 29.4.6",
    "dist": "electron-builder --win --x64"
  },
  "author": "Lunev",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@pixiv/three-vrm": "^3.5.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.lunev.claude-companion",
    "productName": "Claude Companion",
    "asar": false,
    "compression": "store",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "config.json",
      "scripts/**",
      "templates/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/three/examples/jsm",
        "to": "app/node_modules/three/examples/jsm"
      },
      {
        "from": "vendor",
        "to": "app/vendor"
      },
      {
        "from": "models",
        "to": "app/models"
      },
      {
        "from": "sidecar/silero_tts.py",
        "to": "app/sidecar/silero_tts.py"
      },
      {
        "from": "sidecar/rshift-hook.ps1",
        "to": "app/sidecar/rshift-hook.ps1"
      }
    ],
    "win": {
      "target": "portable"
    },
    "electronVersion": "29.4.6"
  }
}
