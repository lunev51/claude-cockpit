{
  "name": "claude-cockpit",
  "version": "0.1.0",
  "description": "Cockpit для Claude Code: вкладки-проекты, авто-resume, дашборд лимитов",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test",
    "postinstall": "cd node_modules/@homebridge/node-pty-prebuilt-multiarch && npx prebuild-install --runtime electron --target 29.4.6",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.lunev.claude-cockpit",
    "productName": "Cockpit",
    "asar": false,
    "compression": "store",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/**",
      "config.json",
      "node_modules/**"
    ],
    "win": {
      "target": "portable"
    },
    "electronVersion": "29.4.6"
  }
}
